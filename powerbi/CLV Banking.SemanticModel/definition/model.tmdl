model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ProjectFolder", "Customer", "State", "Scenario", "Calendar Year", "Customer Year", "Value Component", "CLV Projection", "State Projection", "Transition Matrix", "Assumption", "Backtest Metric", "Backtest State", "Stationarity", "Pipeline Test", "Discount Rate", "Key Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customer
ref table State
ref table Scenario
ref table 'Calendar Year'
ref table 'Customer Year'
ref table 'Value Component'
ref table 'CLV Projection'
ref table 'State Projection'
ref table 'Transition Matrix'
ref table Assumption
ref table 'Backtest Metric'
ref table 'Backtest State'
ref table Stationarity
ref table 'Pipeline Test'
ref table 'Discount Rate'
ref table 'Key Measures'

ref cultureInfo en-US

