	partition Stationarity = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\data\mart\stationarity.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"from_state_id", Int64.Type}, {"from_state", type text}, {"to_state_id", Int64.Type}, {"to_state", type text}, {"n_early", Int64.Type}, {"n_late", Int64.Type}, {"p_early", type number}, {"p_late", type number}, {"p_shift", type number}, {"chi_square_contribution", type number}}, "en-US")
				in
